# The site and curated portfolio guide work without secrets.
AI_CHAT_ENABLED=false

# Optional live AI, only after verifying the shared limiter and hosting firewall.
# OPENAI_API_KEY=
# AI_CHAT_MODEL=gpt-4.1-mini
# UPSTASH_REDIS_REST_URL=https://your-dedicated-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# CHAT_RATE_LIMIT_SECRET=

# Exact origins. Set an explicit preview origin when testing a deployed preview.
CHAT_ALLOWED_ORIGINS=https://jessicacheng.studio,https://www.jessicacheng.studio

# VERCEL is set by the platform. Never set it to spoof trusted hosting locally.
